# Copy this file to .env and fill in real values. Never commit .env.
# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# Free tier allows 15 requests per minute per model. Stay under it.
GEMINI_RPM=12
# Comments sent per extraction request. Set to 1 for one comment per request.
GEMINI_BATCH_SIZE=10
GEMINI_MAX_RETRIES=5
# Local MongoDB started by the setup steps
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=consultation
PORT=3000

# Regulations.gov / api.data.gov key for the fetch script
# Free signup: https://api.data.gov/signup
REG_GOV_API_KEY=your_key_here

# Upload caps. Every row costs a paced Gemini request, so an unbounded upload
# would eat the daily quota. A longer file is truncated, not rejected.
MAX_COMMENTS=300
MAX_UPLOAD_BYTES=5000000
